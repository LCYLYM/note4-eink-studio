# Listen host and port
HOST=127.0.0.1
PORT=8799

# Local single-user dev mode (true skips login on localhost; set false in production)
NOTE4_LEGACY_DEV=true

# State directory for SQLite database and sealing key
NOTE4_STATE_DIR=.local/studio

# OpenAI-compatible AI model configuration (server-side only, never exposed to browser)
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-chat
MODEL_API_KEY=your-api-key-here

# Production settings (optional when running locally)
# PUBLIC_ORIGIN=https://your-domain.example.com
# BOOTSTRAP_TOKEN=replace-with-random-secret
# APP_SEAL_KEY=replace-with-64-hex-chars

# Optional SSO login configuration (production)
# SSO_ISSUER=https://your-sso.example.com
# SSO_CLIENT_ID=your-client-id
# SSO_KEY_ID=your-key-id
# SSO_REDIRECT_URI=https://your-domain.example.com/api/auth/sso/callback
# SSO_CLIENT_HMAC_SECRET=replace-with-hmac-secret
